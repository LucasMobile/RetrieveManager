COMPOSE_BAKE=false
APP_ENV=production
LOG_LEVEL=INFO

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
RETRIEVE_ADMIN_USER=admin
# Use aspas simples se a senha contiver #, $, espaços ou outros caracteres especiais.
RETRIEVE_ADMIN_PASSWORD=substitua-por-uma-senha-forte-de-pelo-menos-12-caracteres

# Banco PostgreSQL usado pelos serviços web, worker e receiver. A senha pode
# conter qualquer caractere (@, :, /...): o app monta a conexão sem URL.
POSTGRES_DB=retrieve
POSTGRES_USER=retrieve
POSTGRES_PASSWORD=substitua-por-uma-senha-forte-do-postgresql

# A tela (porta APP_PORT, padrão 8080) escuta só em 127.0.0.1 para o proxy
# reverso local. Use 0.0.0.0 apenas nos testes por IP descritos abaixo.
APP_BIND_ADDRESS=127.0.0.1

# Produção exige HTTPS no proxy reverso e a origem pública exata.
ALLOW_HTTP_FOR_TESTS=false
SESSION_HTTPS_ONLY=true
PUBLIC_ORIGIN=https://retrieve.exemplo.com

# Proteção por IP. Os valores padrão abaixo correspondem à política recomendada.
GLOBAL_RATE_LIMIT_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Confie somente no IP/sub-rede do proxy reverso. Nunca use * em uma porta pública.
FORWARDED_ALLOW_IPS=127.0.0.1

# Consulta da API Pedido PLERES (o endpoint e o token são cadastrados por unidade).
ORDERS_API_POLL_SECONDS=30
ORDERS_API_TIMEOUT_SECONDS=60
ORDERS_API_MAX_RETRIES=3
ORDERS_API_ACK_BATCH_SIZE=32
ORDERS_API_ACK_CONCURRENCY=8
ORDERS_API_ACK_UNIT_WORKERS=4
ORDERS_API_INGEST_UNIT_WORKERS=4

# C-FIND executa um pedido por job, independente da compactação/envio.
FIND_UNIT_SCHEDULERS=8
FIND_ORDERS_PER_UNIT=4
FIND_TIMEOUT_SECONDS=20
# Monitoramento de novas imagens após o 1º retrieve (threads próprias).
MONITOR_UNIT_SCHEDULERS=4
MONITOR_CHECKS_PER_UNIT=2
MONITOR_BATCH_SIZE=25
# Limites por ciclo evitam picos de memória quando o PACS envia lotes grandes.
COMPACT_BATCH_SIZE=250
COMPACT_GLOBAL_WORKERS=8
COMPACT_DB_BATCH_SIZE=25
COMPACT_TEMP_MAX_AGE_SECONDS=3600
# Tempo máximo do codec por arquivo; acima de COMPACT_MAX_ENCODE_BYTES o
# arquivo segue sem recompressão.
COMPACT_FILE_TIMEOUT_SECONDS=300
COMPACT_MAX_ENCODE_BYTES=268435456
COMPACT_UNIT_SCHEDULERS=4
SEND_UNIT_SCHEDULERS=4
DASHBOARD_FILE_COUNT_CACHE_SECONDS=30
SEND_DB_BATCH_SIZE=50
SEND_DB_FLUSH_MILLISECONDS=250
SEND_DRAIN_SECONDS=20
# Tentativas de envio antes do estado send_error (reenvio manual na tela).
SEND_MAX_ATTEMPTS=7
SEND_GLOBAL_CONCURRENCY=32

# Receptor DICOM (serviço receiver). Pico de memória ~ associações x maior objeto.
RECEIVER_MAX_ASSOCIATIONS=10
RECEIVER_MIN_FREE_MB=1024
RECEIVER_COMMIT_TIMEOUT_SECONDS=30
RECEIVER_FSYNC=false
RECEIVE_ADOPT_MIN_AGE_SECONDS=60

# Para testes por IP via HTTP, substitua as três linhas acima por:
# ALLOW_HTTP_FOR_TESTS=true
# SESSION_HTTPS_ONLY=false
# PUBLIC_ORIGIN=
# e publique a tela em todas as interfaces:
# APP_BIND_ADDRESS=0.0.0.0
# Com a origem vazia, a validação usa o IP e a porta acessados no navegador.
